          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(node_readiness_taint_operations_total{rule=~\"$rule\"}[$__rate_interval]))",
          "legendFormat": "taints/s",
          "range": true,
          "refId": "A"
        }
